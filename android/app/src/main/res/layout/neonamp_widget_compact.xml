<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="4dp"
    android:gravity="center_vertical"
    android:background="#151122">
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Album artwork" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="NeonAmp" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nothing queued" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Previous track" />
    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play or pause" />
    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="Next track" />
    <ImageButton
        android:id="@+id/widget_queue"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_agenda"
        android:contentDescription="Open queue" />
</LinearLayout>
